# lovable-tagger (outil de l'éditeur Lovable, chargé en développement
# seulement) déclare `vite < 8` dans ses dépendances pairs, alors que le projet
# tourne sur Vite 8. Sans cette ligne, `npm ci` échoue chez l'hébergeur comme
# en CI (erreur ERESOLVE) et le site ne se construit pas.
legacy-peer-deps=true
